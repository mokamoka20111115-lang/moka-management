# Copy to functions/.env.moka-management only when deployment is authorized.
# UID is an identifier, not a secret. Only this UID is accepted by this release.
MOKA_ALLOWED_UID=JR8vRpF9uyaOnNONszt4vYcYBWd2
# Set the actual root Cloud Run URL AFTER the first disabled deployment.
MOKA_MCP_BASE_URL=
# Copy the EXACT callback URI shown by ChatGPT. Do not use a wildcard.
MOKA_OAUTH_REDIRECT_URIS=[]
# Create this keyless service account with the database-scoped roles in docs/mcp-setup.md.
MOKA_MCP_SERVICE_ACCOUNT=moka-mcp-reader@moka-management.iam.gserviceaccount.com
