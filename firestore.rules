rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function oldRevision(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/state/current;
      return exists(path) ? get(path).data.revision : 0;
    }
    function bumped(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/state/current).data.revision == oldRevision(uid) + 1;
    }
    function money(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }
    function validDate(date) {
      let parts = date.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let days = month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31);
      return month >= 1 && month <= 12 && day >= 1 && day <= days;
    }
    function entry(data, date) {
      return data.keys().hasAll(['date','dineIn','uberOrder','uberPaid','demaeOrder','demaePaid','rocketOrder','rocketPaid','ingredients','supplies'])
        && data.keys().hasOnly(['date','dineIn','uberOrder','uberPaid','demaeOrder','demaePaid','rocketOrder','rocketPaid','ingredients','supplies'])
        && data.date is string && data.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validDate(date)
        && money(data.dineIn) && money(data.uberOrder) && money(data.uberPaid)
        && money(data.demaeOrder) && money(data.demaePaid)
        && money(data.rocketOrder) && money(data.rocketPaid)
        && money(data.ingredients) && money(data.supplies);
    }
    match /users/{uid}/entries/{date} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && entry(request.resource.data, date) && bumped(uid);
      allow delete: if owner(uid) && bumped(uid);
    }
    match /users/{uid}/state/current {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision'])
        && request.resource.data.revision is int
        && request.resource.data.revision > 0 && request.resource.data.revision <= 9007199254740991
        && request.resource.data.revision == oldRevision(uid) + 1;
      allow delete: if false;
    }
    // 上記以外は拒否。各ユーザーは自分のUID配下だけ利用可能。
  }
}
